			"contracts/types/DeworkType.sol": {
				"content": "struct FreelancerProfile{\n    uint256 id;\n    string name;\n    address wallet;\n    uint8 experienceYears;\n    bool isAvaliableHere;\n    uint256 hourlyRateWei;\n}\n\nstruct EmployeeProfile{\n    uint256 id;\n    string name;\n    bool isHiring;\n    address wallet; \n    JobListing[] jobListing;\n}\n\nstruct createJobListingInput{\n    string title;\n    string description;\n    uint256 deadline;\n    uint256 fixedPriceInWei;\n}\n\nstruct JobListing{\n    uint256 id;\n    string title;\n    string description;\n    uint256 deadlineTimestamp;\n    bool isOpen;\n    uint256 fixedPriceInWei;\n    uint256 hiredFreelancerId;\n    bool hasHiredFreelancer;\n    bool isPaid;\n}"
			}
		}
	},
